{
  "name": "xmage-launcher",
  "version": "1.2.2",
  "description": "Arcane Electron launcher for XMage (Darrell's Fork)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never"
  },
  "author": "Darrell Best",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "tar": "^6.2.1"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.darrellbest.xmagelauncher",
    "productName": "XMage Launcher",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "artifactName": "XMageLauncher-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "artifactName": "XMageLauncher-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "artifactName": "XMageLauncher-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "DarrellBest",
      "repo": "Launcher"
    }
  }
}
